# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- InjectionShield ----
# Python
research/.venv/
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Hugging Face / model caches
.cache/
research/.hf_cache/
research/cache/
*.safetensors
*.bin
*.pt
*.onnx

# Large raw data and intermediate artifacts (regenerated by the pipeline)
research/data/raw/*
!research/data/raw/.gitkeep
research/data/processed/*.parquet

# trained model binaries (browser exports live in public/model)
research/models/

# QA run artefacts (regenerated by qa/*.py)
qa/*_report.json

# ---- Public repo = code + summary only (author's choice; see DATA_CARD.md "Data availability") ----
# Benchmark text, translations, LLM-assisted and independently supplied sentences stay local.
research/data/**
!research/data/**/
!research/data/**/.gitkeep
# Per-example error dumps and caches contain dataset text or are large; summaries are kept.
research/results/errors.json
research/results/predictions/
research/results/*.log
.next-dev.log
linkedin-screenshots/
